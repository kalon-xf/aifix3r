# Server-only configuration. Never prefix these values with NEXT_PUBLIC_.
# Use a newly rotated credential; do not reuse a key exposed in chat or Git history.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional. Required for private repositories and useful for higher API limits.
GITHUB_TOKEN=

# Local execution worker. Use a long random value and keep the worker bound to localhost.
AIFIX3R_LOCAL_USER=
AIFIX3R_WORKER_URL=http://127.0.0.1:7331
AIFIX3R_WORKER_TOKEN=
AIFIX3R_WORKER_HOST=127.0.0.1
AIFIX3R_WORKER_PORT=7331
AIFIX3R_WORKER_CONCURRENCY=2
